# Maintainer: Matthias Haas <matthias.haas@mattlab.at>
pkgname=ccsm-go-git
pkgver=2.0.0.r0.g0000000
pkgrel=1
pkgdesc="Claude Code Session Manager (Go version) - save, tag, search and resume Claude Code sessions"
arch=('x86_64' 'aarch64')
url="https://github.com/mattlab76/ccsm-go"
license=('MIT')
depends=('jq' 'python')
optdepends=(
    'zsh: tab completion'
)
makedepends=('git' 'go>=1.21')
provides=('ccsm')
conflicts=('ccsm' 'ccsm-git')
source=("git+https://github.com/mattlab76/ccsm-go.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/ccsm-go"
    git describe --long --abbrev=7 --tags 2>/dev/null | sed 's/^v//;s/-/.r/;s/-/./' || \
        printf "2.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$srcdir/ccsm-go"
    export CGO_ENABLED=0
    go build -trimpath -ldflags '-s -w' -o ccsm ./cmd/ccsm
}

check() {
    cd "$srcdir/ccsm-go"
    go test ./...
}

package() {
    cd "$srcdir/ccsm-go"

    # Main executable
    install -Dm755 ccsm "$pkgdir/usr/bin/ccsm"

    # Hook script
    if [ -f hooks/session_end.sh ]; then
        install -Dm755 hooks/session_end.sh "$pkgdir/usr/share/ccsm/hooks/session_end.sh"
    fi

    # Zsh completion (generated by cobra)
    ./ccsm completion zsh > _ccsm 2>/dev/null || true
    if [ -f _ccsm ] && [ -s _ccsm ]; then
        install -Dm644 _ccsm "$pkgdir/usr/share/zsh/site-functions/_ccsm"
    fi

    # Documentation
    install -Dm644 CLAUDE.md "$pkgdir/usr/share/doc/ccsm-go/CLAUDE.md"
    [ -f LICENSE ] && install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ccsm-go/LICENSE"
}
